{
  "name": "aura-website",
  "version": "1.0.0",
  "private": true,
  "description": "AURA Phnom Penh restaurant website (Next.js static export on Cloudflare Workers)",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "photos": "node scripts/photos.mjs src/content/home.ts",
    "check": "npm run lint && npm run typecheck && npm run build"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "6.4.0",
    "clsx": "^2.1.1",
    "lenis": "^1.3.26",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.141.0"
  }
}
